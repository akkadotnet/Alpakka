{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "Amqp/Akka.Streams.Amqp.V1/Akka.Streams.Amqp.V1.csproj",
            "Amqp/Akka.Streams.Amqp.RabbitMq/Akka.Streams.Amqp.RabbitMq.csproj",
            "Azure/Akka.Streams.Azure.EventHub/Akka.Streams.Azure.EventHub.csproj",
            "Azure/Akka.Streams.Azure.ServiceBus/Akka.Streams.Azure.ServiceBus.csproj",
            "Azure/Akka.Streams.Azure.StorageQueue/Akka.Streams.Azure.StorageQueue.csproj",
            "AWS/Kinesis/Akka.Streams.Kinesis/Akka.Streams.Kinesis.csproj",
            "AWS/SNS/Akka.Streams.Sns/Akka.Streams.Sns.csproj",
            "AWS/SQS/Akka.Streams.SQS/Akka.Streams.SQS.csproj",
            "Csv/Akka.Streams.Csv/Akka.Streams.Csv.csproj",
            "File/Akka.Streams.File/Akka.Streams.File.csproj",
            "SignalR/Akka.Streams.SignalR/Akka.Streams.SignalR.csproj",
            "Xml/Akka.Streams.Xml/Akka.Streams.Xml.csproj"
          ],
          "exclude": [
            "**/obj/**",
            "**/bin/**",
            "_site/**",
            "**/examples/**",
            "**/benchmark/**",
            "**/*TestRunner*.csproj",
            "**/Akka.Docs.*.csproj",
            "**/*Tests*.csproj",
            "**/*Tests.*.csproj"
          ],
          "src": "../src"
        }
      ],
      "dest": "api",
      "filter": "filterConfig.yml"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md"
        ]
      },
      {
        "files": [
          "documentation/**/**.md",
          "documentation/**/toc.yml",
          "community/**/**.md",
          "community/**/toc.yml",
          "toc.yml",
          "*.md"
        ],
        "exclude": [
          "obj/**",
          "_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**",
          "web.config",
          "xrefmap.yml"
        ],
        "exclude": [
          "obj/**",
          "_site/**"
        ]
      }
    ],
    "overwrite": [
      {
        "files": [
          "apidoc/**.md"
        ],
        "exclude": [
          "obj/**",
          "_site/**"
        ]
      }
    ],
    "xref": [
      "https://learn.microsoft.com/en-us/dotnet/.xrefmap.json"
    ],
    "globalMetadata": {
      "_appTitle": "Akka.NET Alpakka Documentation",
      "_appLogoPath": "/images/akkalogo.png",
      "_appFaviconPath": "/images/favicon.ico",
      "_appFooter": "Copyright © 2013-2020 Akka.NET project<br>Generated by <strong>DocFX</strong>",
      "_enableSearch": "true"
    },
    "dest": "_site",
    "globalMetadataFiles": [],
    "fileMetadataFiles": [],
    "template": [
      "default",
      "template"
    ],
    "postProcessors": [ "ExtractSearchIndex" ],
    "noLangKeyword": false
  }
}
