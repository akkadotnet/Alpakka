<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyTitle>Akka.Streams.Azure.EventHubs.V5</AssemblyTitle>
        <Description>Azure EventHubs adapter for Akka.NET Streams</Description>
        <TargetFrameworks>$(NetStandardLibVersion);$(NetLibVersion)</TargetFrameworks>
        <PackageTags>$(AkkaPackageTags);azure;EventHubs</PackageTags>
        <RootNamespace>Akka.Streams.Azure.EventHub</RootNamespace>
        <Nullable>enable</Nullable>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <EnablePackageValidation>true</EnablePackageValidation>
        <PackageValidationBaselineVersion>1.5.59</PackageValidationBaselineVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Akka.Streams" />
        <PackageReference Include="Azure.Messaging.EventHubs.Processor" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="" />
    </ItemGroup>

</Project>
