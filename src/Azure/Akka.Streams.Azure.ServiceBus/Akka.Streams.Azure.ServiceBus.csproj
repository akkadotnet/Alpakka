<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyTitle>Akka.Streams.Azure.ServiceBus</AssemblyTitle>
        <Description>Azure Service Bus sources and batched sinks for Akka.NET Streams</Description>
        <TargetFrameworks>$(NetStandardLibVersion);$(NetLibVersion)</TargetFrameworks>
        <PackageTags>$(AkkaPackageTags);azure;ServiceBus</PackageTags>
        <Platforms>AnyCPU</Platforms>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <EnablePackageValidation>true</EnablePackageValidation>
        <PackageValidationBaselineVersion>1.5.59</PackageValidationBaselineVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Akka.Streams" />
        <PackageReference Include="Azure.Messaging.ServiceBus" />
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="" />
    </ItemGroup>

</Project>
